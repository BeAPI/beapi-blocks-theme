{
	"version": 2,
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"settings": {
		"appearanceTools": true,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": false,
			"palette": [
				{
					"slug": "base",
					"color": "var(--theme--preset--color--base)",
					"name": "Base"
				},
				{
					"slug": "contrast",
					"color": "var(--theme--preset--color--contrast)",
					"name": "Contrast"
				},
				{
					"slug": "primary",
					"color": "var(--theme--preset--color--primary)",
					"name": "Primary"
				},
				{
					"slug": "secondary",
					"color": "var(--theme--preset--color--secondary)",
					"name": "Secondary"
				}
			]
		},
		"layout": {
			"contentSize": "var(--theme--preset--align-default)",
			"wideSize": "var(--theme--preset--align-wide)"
		},
		"spacing": {
			"customSpacingSize": true,
			"spacingScale": {
				"increment": 8,
				"mediumStep": 8,
				"operator": "*",
				"steps": 0,
				"unit": "rem"
			},
			"spacingSizes": [
				{
					"name": "10",
					"size": "var(--theme--preset--spacing--10)",
					"slug": "10"
				},
				{
					"name": "20",
					"size": "var(--theme--preset--spacing--20)",
					"slug": "20"
				},
				{
					"name": "30",
					"size": "var(--theme--preset--spacing--30)",
					"slug": "30"
				},
				{
					"name": "40",
					"size": "var(--theme--preset--spacing--40)",
					"slug": "40"
				},
				{
					"name": "50",
					"size": "var(--theme--preset--spacing--50)",
					"slug": "50"
				},
				{
					"name": "60",
					"size": "var(--theme--preset--spacing--60)",
					"slug": "60"
				},
				{
					"name": "70",
					"size": "var(--theme--preset--spacing--70)",
					"slug": "70"
				},
				{
					"name": "80",
					"size": "var(--theme--preset--spacing--80)",
					"slug": "80"
				}
			],
			"units": [
				"%",
				"px",
				"em",
				"rem",
				"vh",
				"vw"
			]
		},
		"typography": {
			"dropCap": false,
			"fluid": true,
			"customFontSize": false,
			"fontFamilies": [
				{
					"fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif, \"Apple Color Emoji\", \"Segoe UI Emoji\", \"Segoe UI Symbol\"",
					"name": "System",
					"slug": "primary"
				},
				{
					"fontFamily": "\"Inter\", sans-serif",
					"name": "Inter",
					"slug": "secondary",
					"fontFace": [
						{
							"fontFamily": "Inter",
							"fontWeight": "400",
							"fontStyle": "normal",
							"fontStretch": "normal",
							"src": [
								"file:./assets/fonts/Inter-Regular.woff2"
							]
						},
						{
							"fontFamily": "Inter",
							"fontWeight": "300",
							"fontStyle": "normal",
							"fontStretch": "normal",
							"src": [
								"file:./assets/fonts/Inter-Light.woff2"
							]
						},
						{
							"fontFamily": "Inter",
							"fontWeight": "500",
							"fontStyle": "normal",
							"fontStretch": "normal",
							"src": [
								"file:./assets/fonts/Inter-Medium.woff2"
							]
						},
						{
							"fontFamily": "Inter",
							"fontWeight": "700",
							"fontStyle": "normal",
							"fontStretch": "normal",
							"src": [
								"file:./assets/fonts/Inter-Bold.woff2"
							]
						}
					]
				}
			],
			"fontSizes": [
				{
					"name": "X Small",
					"size": "var(--theme--preset--font-size--200)",
					"slug": "x-small"
				},
				{
					"name": "Small",
					"size": "var(--theme--preset--font-size--300)",
					"slug": "small",
					"fluid": false
				},
				{
					"name": "Medium",
					"size": "var(--theme--preset--font-size--400)",
					"slug": "medium",
					"fluid": false
				},
				{
					"name": "Large",
					"size": "var(--theme--preset--font-size--500)",
					"slug": "large",
					"fluid": false
				},
				{
					"name": "X Large",
					"size": "var(--theme--preset--font-size--600)",
					"slug": "x-large",
					"fluid": false
				},
				{
					"name": "XX Large",
					"size": "var(--theme--preset--font-size--700)",
					"slug": "xx-large",
					"fluid": false
				},
				{
					"name": "XXX Large",
					"size": "var(--theme--preset--font-size--800)",
					"slug": "xxx-large",
					"fluid": false
				}
			]
		},
		"useRootPaddingAwareAlignments": true
	},
	"styles": {
		"color": {
			"background": "var(--theme--body--background)",
			"text": "var(--theme--body--color)"
		},
		"elements": {
			"heading": {
				"color": {
					"text": "var(--theme--heading--color)"
				},
				"typography": {
					"fontFamily": "var(--theme--heading--font-family)"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--theme--heading--h1--font-size)",
					"lineHeight": "var(--theme--heading--h1--line-height)"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--theme--heading--h2--font-size)",
					"lineHeight": "var(--theme--heading--h2--line-height)"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--theme--heading--h3--font-size)",
					"lineHeight": "var(--theme--heading--h3--line-height)"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var(--theme--heading--h4--font-size)",
					"lineHeight": "var(--theme--heading--h4--line-height)"
				}
			},
			"h5": {
				"typography": {
					"fontSize": "var(--theme--heading--h5--font-size)",
					"lineHeight": "var(--theme--heading--h5--line-height)"
				}
			},
			"h6": {
				"typography": {
					"fontSize": "var(--theme--heading--h6--font-size)",
					"lineHeight": "var(--theme--heading--h6--line-height)"
				}
			},
			"button": {
			"spacing": {
				"padding": "var(--theme--buttons--padding)"
				},
				"border": {
					"width": "var(--theme--buttons--border-width)",
					"radius": "var(--theme--buttons--radius)",
					"style": "var(--theme--buttons--border-style)",
					"color": "var(--theme--buttons--border-color)"
				},
				"color": {
					"background": "var(--theme--buttons--background)",
					"text": "var(--theme--buttons--color)"
				},
				"typography": {
					"fontSize": "var(--theme--buttons--font-size)",
					"fontWeight": "var(--theme--buttons--font-weight)"
				},
				":hover": {
					"color": {
						"background": "var(--theme--buttons--background-hover)",
						"text": "var(--theme--buttons--color-hover)"
					},
					"border": {
						"color": "var(--theme--buttons--border-color-hover)"
					}
				}
			},
			"caption": {
				"typography": {
					"fontSize": "var(--theme--preset--font-size--200)"
				}
			},
			"cite": {
				"typography": {
					"fontSize": "var(--theme--preset--font-size--200)"
				}
			},
			"link": {
				"color": {
					"text": "var(--theme--preset--color--text)"
				},
				":hover": {
					"color": {
						"text": "var(--theme--preset--color--text)"
					},
					"typography": {
						"textDecoration": "none"
					}
				},
				":focus": {
					"color": {
						"text": "var(--theme--preset--color--text)"
					}
				},
				":active": {
					"color": {
						"text": "var(--theme--preset--color--text)"
					}
				}
			}
		},
		"spacing": {
			"blockGap": "var(--theme--preset--spacing--30)",
			"padding": {
				"right": "var(--theme--preset--spacing--20)",
				"left": "var(--theme--preset--spacing--20)"
			}
		},
		"typography": {
			"fontSize": "var(--theme--preset--font-size--default)",
			"fontFamily": "var(--theme--font-family--primary)",
			"lineHeight": "var(--theme--preset--line-height--400)"
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		}
	]
}
